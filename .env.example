ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# npm run setup generates a unique secret in .env.local.
SESSION_SECRET=replace-with-a-long-random-value
DATABASE_PATH=./data/survey.sqlite
COOKIE_SECURE=false
